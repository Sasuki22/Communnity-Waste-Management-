# ============================================================
# Community Waste Management - Environment Variable Template
#
# Copy this file to ".env" and change the values:
#     Copy-Item .env.example .env
# The real ".env" file is gitignored - NEVER commit it.
# ============================================================

# ---- MySQL (used by the PHP web app through config.php) ----
# Inside Docker, the PHP container always connects to the hostname "db"
# (the MySQL service name) - this is set by docker-compose automatically.
# The DB_HOST below is only relevant when running PHP directly via XAMPP.
DB_HOST=localhost
DB_DATABASE=community_db
DB_USERNAME=cwms
DB_PASSWORD=change_this_mysql_password

# ---- MySQL container (used by the "db" service) ----
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_USER=cwms
MYSQL_PASSWORD=change_this_mysql_password

# ---- Flask API (used by the "api" service) ----
FLASK_SECRET_KEY=change_this_flask_secret_key
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False

# ---- Application ----
APP_NAME=Community Waste Management
APP_ENV=development
APP_TIMEZONE=Asia/Manila