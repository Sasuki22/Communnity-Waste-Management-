# EXAMPLE ENVIRONMENT VARIABLES FILE
# Copy this file to .env and update with your actual configuration
# This file is tracked in git - .env is gitignored for security

# Database Configuration (MySQL/phpMyAdmin)
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=community_db

# Flask/Python Backend Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=True

# Application Settings
APP_NAME=Community Waste Management
APP_ENV=development
APP_TIMEZONE=Asia/Manila
